# Which deployment the open-science notebook talks to.
#
# Copy to demo.env in this directory and fill in. The notebook reads it on
# import, so a change needs a kernel restart. Real environment variables always
# win over this file, so a run can be pointed elsewhere without editing it.
#
#   cp demo.env.example demo.env
#
# demo.env is not committed: it names a deployment and can hold a token.
#
# Without it the URLs below default to localhost, every service reports DOWN,
# and the run is SKIPPED -- which looks like an outage rather than a notebook
# that was never told where to look.

# The four services. AR2's hub and registry, Pancake, and the terrapipe-os node.
# The node is operated separately and is not expected to be local: nothing in
# this notebook computes a reading in process, by design.
HUB_URL=http://<hub-host>:8000
AR2_NODE_URL=http://<ar2-host>:8001
PANCAKE_URL=http://<pancake-host>:8100
TERRAPIPE_OS_URL=http://<node-host>:8200

# The node's agent-facing surface. Its own container and port, so it is set
# rather than derived. Optional: defaults to port 8201 on the node's host.
# TERRAPIPE_OS_MCP_URL=http://<node-host>:8201/mcp

# How the notebook authenticates. An account on the hub is enough; it will be
# registered on first use if it does not exist, and every token below is
# obtained fresh so there is nothing to rotate by hand.
DEMO_EMAIL=you@example.org
DEMO_PASSWORD=change-me

# Alternatives, in the order they are tried:
#   HUB_TOKEN         a bearer token, used as given unless it has expired
#   DEMO_CLIENT_ID    client credentials, exchanged at POST /users/token
#   DEMO_CLIENT_SECRET
